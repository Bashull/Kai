#!/usr/bin/env bash
set -euo pipefail

SCRIPT_PATH=$0
if command -v readlink >/dev/null 2>&1; then
  resolved=$(readlink -f "$0" 2>/dev/null || true)
  [[ -n "$resolved" ]] && SCRIPT_PATH=$resolved
fi
SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$SCRIPT_PATH")" && pwd)
if [[ -f "$SCRIPT_DIR/lib/common.sh" ]]; then
  LIB_DIR="$SCRIPT_DIR/lib"
elif [[ -f "$SCRIPT_DIR/../lib/common.sh" ]]; then
  LIB_DIR=$(CDPATH= cd -- "$SCRIPT_DIR/../lib" && pwd)
else
  printf 'BLOCKED: Kai Mobile Bridge libraries not found.\n' >&2
  exit 66
fi
# shellcheck source=lib/common.sh
source "$LIB_DIR/common.sh"
# shellcheck source=lib/android.sh
source "$LIB_DIR/android.sh"

usage() {
  printf 'usage: kai-mobile {health|status|open-whatsapp|open-app PACKAGE|home|wake|adb-status|doctor}\n' >&2
  exit 64
}

run_launch() {
  local component=$1
  if android_launch_component "$component"; then
    printf '{"ok":true,"action":"launch","component":"%s"}\n' "$component"
    return 0
  else
    local rc=$?
    printf '{"ok":false,"action":"launch","status":"BLOCKED","code":%d}\n' "$rc" >&2
    return "$rc"
  fi
}

run_guarded_action() {
  local action=$1
  shift

  if ! assert_bridge_active; then
    bridge_log "$action" blocked stop
    printf '{"ok":false,"action":"%s","status":"BLOCKED_STOP"}\n' "$action" >&2
    return 75
  fi

  if ! acquire_action_lock; then
    bridge_log "$action" blocked busy
    printf '{"ok":false,"action":"%s","status":"BLOCKED_BUSY"}\n' "$action" >&2
    return 75
  fi

  local rc=0
  if "$@"; then
    rc=0
  else
    rc=$?
  fi
  release_action_lock

  if [[ $rc -eq 0 ]]; then
    bridge_log "$action" ok command-completed
  else
    bridge_log "$action" blocked "rc=$rc"
  fi
  return "$rc"
}

do_home() {
  android_keyevent KEYCODE_HOME
  printf '{"ok":true,"action":"home"}\n'
}

do_wake() {
  android_keyevent KEYCODE_WAKEUP
  printf '{"ok":true,"action":"wake"}\n'
}

command=${1-}
case "$command" in
  health|status)
    bridge_json_ok
    ;;
  open-whatsapp)
    component=$(resolve_component_for_package com.whatsapp) || { printf 'WhatsApp is not allowlisted.\n' >&2; exit 64; }
    run_guarded_action open-whatsapp run_launch "$component"
    ;;
  open-app)
    [[ $# -eq 2 ]] || usage
    component=$(resolve_component_for_package "$2") || { printf 'Package is not allowlisted.\n' >&2; exit 64; }
    run_guarded_action open-app run_launch "$component"
    ;;
  home)
    run_guarded_action home do_home
    ;;
  wake)
    run_guarded_action wake do_wake
    ;;
  adb-status)
    if state=$(adb_state 2>/dev/null); then
      printf '{"ok":true,"adb_state":"%s"}\n' "$state"
    else
      printf '{"ok":false,"adb_state":"BLOCKED"}\n'
      exit 77
    fi
    ;;
  doctor)
    printf '{"ok":true,"classification":"UNRESOLVED","doctor":"minimal"}\n'
    ;;
  *)
    usage
    ;;
esac
