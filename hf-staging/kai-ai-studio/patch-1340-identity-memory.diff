+from __future__ import annotations
+
+
+def enrich_identity_prompt(prompt: str, reference_count: int) -> str:
+    clean = (prompt or "").strip()
+    count = max(0, int(reference_count))
+    if count == 0:
+        return clean
+    return (
+        f"{clean}\n\n"
+        f"IDENTITY LOCK: The first image is the edit target. The next {count} approved "
+        "reference images show the same person and are identity evidence only. Preserve "
+        "facial structure, skull and jaw proportions, eyes, nose, mouth, skin traits, "
+        "body proportions and stable physical identity. Do not copy pose, clothing, "
+        "background or lighting from references unless the user request explicitly asks for it."
+    )
