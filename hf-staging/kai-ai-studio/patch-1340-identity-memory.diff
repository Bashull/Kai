+    def identity_references(self, profile_id: str, limit: int = 4) -> list[str]:
+        profile = self.get_profile(profile_id)
+        root = self.people / profile["id"]
+        groups = [root / "anchors", root / "winners"]
+        seen: set[str] = set()
+        refs: list[str] = []
+        for folder in groups:
+            if not folder.exists():
+                continue
+            files = sorted(
+                (p for p in folder.iterdir() if p.is_file()),
+                key=lambda p: (p.stat().st_mtime_ns, p.name),
+                reverse=True,
+            )
+            for path in files:
+                digest = hashlib.sha256(path.read_bytes()).hexdigest()
+                if digest in seen:
+                    continue
+                seen.add(digest)
+                refs.append(str(path))
+                if len(refs) >= max(0, int(limit)):
+                    return refs
+        return refs
