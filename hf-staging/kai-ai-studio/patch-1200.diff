+    result = launcher(payload, token, namespace)
+    record = {
+        "requested_at": _now(),
+        "namespace": namespace,
+        "flavor": flavor,
+        "job": result,
+    }
+    manifest_path = Path(str(manifest.get("manifest_path", "")))
+    if manifest_path.is_file():
+        _write_json(manifest_path.parent / "job.json", record)
+    return result
