+    run = studio_store.record_candidates(run_id, int(index), path_a, path_b, int(seed_a), int(seed_b))
+    return run
+
+
+def studio_current_review(run_id: str):
+    run = studio_store.get_run(run_id)
+    cursor = int(run["cursor"])
+    if cursor >= len(run["items"]):
+        return None, cursor, "Lote terminado ✅"
+    item = run["items"][cursor]
+    return item["source"], cursor, f"Imagen {cursor + 1}/{len(run['items'])} · {Path(item['source']).name}"
+
+
+def studio_list_profiles():
+    return studio_store.list_profiles()
+
+
+def studio_list_runs():
+    runs = []
+    for manifest in sorted(STUDIO_ROOT.glob("runs/*/manifest.json"), reverse=True):
+        try:
+            run = studio_store.get_run(manifest.parent.name)
+            runs.append({
+                "id": run["id"],
+                "profile_id": run["profile_id"],
+                "prompt": run["prompt"],
+                "cursor": run["cursor"],
+                "total": len(run["items"]),
+                "created_at": run["created_at"],
+            })
+        except Exception:
+            continue
+    return runs
+
+
+def studio_choose_review(run_id: str, index: int, choice: str, promote: bool = False):
+    run = studio_store.choose(run_id, int(index), choice, bool(promote))
+    item = run["items"][int(index)]
+    return run, item.get("winner"), item.get("anchor"), run["cursor"]
+
+
+def studio_skip_review(run_id: str, index: int):
+    run = studio_store.skip(run_id, int(index))
+    return run, run["cursor"]
+
+
+def studio_copilot(message: str, history, oauth_token: gr.OAuthToken | None):
+    clean = (message or "").strip()
+    if not clean:
+        return "", history or []
+    try:
+        reply = copilot_reply(clean, history or [], oauth_token=oauth_token)
+    except ValueError as exc:
+        raise gr.Error(str(exc))
+    updated = list(history or [])
+    updated.append({"role": "user", "content": clean})
+    updated.append({"role": "assistant", "content": reply})
+    return "", updated
+
+
+def studio_training_readiness(profile_id: str):
+    try:
+        profile = studio_store.get_profile(profile_id)
+    except KeyError as exc:
+        raise gr.Error(str(exc))
+    return training_readiness(profile)
+
+
+def studio_prepare_training(profile_id: str):
+    try:
+        manifest = build_training_manifest(studio_store, profile_id)
+    except KeyError as exc:
+        raise gr.Error(str(exc))
+    return manifest, manifest.get("readiness", {})
+
+
+def studio_launch_training(manifest: dict, flavor: str, confirm_paid: bool, oauth_token: gr.OAuthToken | None):
+    if not confirm_paid:
+        raise gr.Error("Marca la confirmación de cómputo de pago antes de lanzar el Job.")
+    if not manifest:
+        raise gr.Error("Prepara primero el dataset de entrenamiento.")
+    readiness = manifest.get("readiness") or {}
+    if not readiness.get("ready"):
+        raise gr.Error("El perfil aún no tiene suficientes ganadoras/anclas aprobadas para autoentrenar con seguridad.")
+    try:
+        return launch_training_job(manifest, oauth_token=oauth_token, flavor=flavor)
+    except ValueError as exc:
+        raise gr.Error(str(exc))
+
+
+def studio_system_inventory():
+    data = migration_inventory()
+    data["studio_root"] = str(STUDIO_ROOT)
+    data["storage_available"] = STUDIO_ROOT.exists()
+    data["copilot_model"] = DEFAULT_MODEL
+    return data
+
