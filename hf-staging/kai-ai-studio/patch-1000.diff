+from __future__ import annotations
+
+import json
+import os
+import shutil
+import uuid
+from datetime import datetime, timezone
+from pathlib import Path
+from typing import Any
+
+from .storage import StudioStore, safe_slug
+
+MIN_APPROVED_PAIRS = 12
+MIN_ANCHORS = 4
+DEFAULT_JOB_IMAGE = "pytorch/pytorch:2.6.0-cuda12.4-cudnn9-devel"
+DEFAULT_SPACE = "Bashull/Qwen-Image-Edit-2511-LoRAs-Fast"
+DEFAULT_BUCKET = "Bashull/Qwen-Image-Edit-2511-LoRAs-Fast-storage"
+
+
+def _now() -> str:
+    return datetime.now(timezone.utc).isoformat()
+
+
+def _token_value(value: Any) -> str:
+    if isinstance(value, str):
+        return value.strip()
+    return (getattr(value, "token", None) or "").strip()
+
+
+def training_readiness(profile: dict[str, Any]) -> dict[str, Any]:
+    stats = profile.get("stats") or {}
+    approved = int(stats.get("likes", 0) or 0)
+    anchors = int(stats.get("anchors", 0) or 0)
+    ready = approved >= MIN_APPROVED_PAIRS and anchors >= MIN_ANCHORS
+    return {
+        "ready": ready,
+        "approved_pairs": approved,
+        "anchors": anchors,
+        "required_pairs": MIN_APPROVED_PAIRS,
+        "required_anchors": MIN_ANCHORS,
+        "status": "eligible" if ready else "collecting",
+    }
+
+
+def _iter_approved_pairs(store: StudioStore, profile_id: str):
+    for manifest_path in sorted(store.runs.glob("*/manifest.json")):
+        try:
+            run = store.get_run(manifest_path.parent.name)
+        except Exception:
+            continue
+        if run.get("profile_id") != safe_slug(profile_id):
+            continue
+        for item in run.get("items", []):
+            winner = item.get("winner")
+            source = item.get("source")
+            if item.get("status") != "done" or not winner or not source:
+                continue
+            winner_path = Path(winner)
+            source_path = Path(source)
+            if winner_path.is_file() and source_path.is_file():
+                yield {
+                    "run_id": run["id"],
+                    "index": int(item["index"]),
+                    "source": source_path,
+                    "winner": winner_path,
+                    "prompt": run.get("prompt", ""),
+                    "anchor": bool(item.get("anchor")),
+                }
+
+
+def _write_json(path: Path, data: Any) -> None:
+    path.parent.mkdir(parents=True, exist_ok=True)
+    tmp = path.with_name(f".{path.name}.{uuid.uuid4().hex}.tmp")
+    tmp.write_text(json.dumps(data, ensure_ascii=False, indent=2), encoding="utf-8")
+    os.replace(tmp, path)
+
+
+def build_training_manifest(store: StudioStore, profile_id: str) -> dict[str, Any]:
+    profile = store.get_profile(profile_id)
+    training_id = f"train-{datetime.now(timezone.utc):%Y%m%d-%H%M%S}-{uuid.uuid4().hex[:8]}"
+    root = store.root / "training" / profile["id"] / training_id
+    dataset = root / "dataset"
+    refs = dataset / "refs"
+    targets = dataset / "targets"
+    refs.mkdir(parents=True, exist_ok=True)
+    targets.mkdir(parents=True, exist_ok=True)
+
+    rows = []
+    pairs = list(_iter_approved_pairs(store, profile["id"]))
+    for n, pair in enumerate(pairs):
+        ref_ext = pair["source"].suffix.lower() or ".jpg"
+        target_ext = pair["winner"].suffix.lower() or ".png"
+        ref_name = f"{n:04d}_reference{ref_ext}"
+        target_name = f"{n:04d}_target{target_ext}"
+        shutil.copy2(pair["source"], refs / ref_name)
+        shutil.copy2(pair["winner"], targets / target_name)
+        rows.append({
+            "image": f"targets/{target_name}",
+            "edit_image": [f"refs/{ref_name}"],
+            "prompt": pair["prompt"],
+        })
+
+    metadata_path = dataset / "metadata.json"
+    _write_json(metadata_path, rows)
+    manifest_path = root / "manifest.json"
+    manifest = {
+        "id": training_id,
+        "profile_id": profile["id"],
+        "created_at": _now(),
+        "pair_count": len(rows),
+        "anchor_count": int(profile.get("stats", {}).get("anchors", 0) or 0),
+        "dataset_dir": str(dataset),
+        "metadata_path": str(metadata_path),
+        "manifest_path": str(manifest_path),
+        "readiness": training_readiness(profile),
+        "recipe": {
+            "framework": "DiffSynth-Studio",
+            "base_model": "Qwen/Qwen-Image-Edit-2511",
+            "learning_rate": 1e-4,
+            "epochs": 5,
+            "dataset_repeat": 3,
+            "max_pixels": 1048576,
+            "lora_rank": 32,
+            "zero_cond_t": True,
+        },
+    }
+    _write_json(manifest_path, manifest)
+    return manifest
+
+
+def build_job_payload(manifest: dict[str, Any], flavor: str = "h200") -> dict[str, Any]:
+    profile = safe_slug(manifest.get("profile_id", "profile"))
+    manifest_path = str(manifest["manifest_path"])
+    return {
+        "dockerImage": DEFAULT_JOB_IMAGE,
+        "command": ["python", "/workspace/training/qwen_identity_job.py", "--manifest", manifest_path],
+        "flavor": flavor,
+        "timeoutSeconds": 21600,
+        "attempts": 1,
+        "labels": {"app": "kai-ai-studio", "profile": profile, "task": "qwen2511-lora"},
+        "volumes": [
+            {
+                "type": "space",
+                "source": DEFAULT_SPACE,
+                "mountPath": "/workspace",
+                "readOnly": True,
+            },
+            {
+                "type": "bucket",
+                "source": DEFAULT_BUCKET,
+                "mountPath": "/data",
+                "readOnly": False,
+            },
+        ],
+    }
+
+
+def _http_job_launcher(payload: dict[str, Any], token: str, namespace: str) -> dict[str, Any]:
+    import requests
+
+    response = requests.post(
+        f"https://huggingface.co/api/jobs/{namespace}",
+        headers={"Authorization": f"Bearer {token}"},
+        json=payload,
+        timeout=60,
+    )
+    response.raise_for_status()
+    return response.json()
+
+
+def launch_training_job(
+    manifest: dict[str, Any],
+    *,
+    oauth_token,
+    namespace: str = "Bashull",
+    launcher=None,
+    flavor: str = "h200",
+) -> dict[str, Any]:
+    token = _token_value(oauth_token)
+    if not token:
+        raise ValueError("Sign in with Hugging Face before launching a training Job")
+    payload = build_job_payload(manifest, flavor=flavor)
+    launcher = launcher or _http_job_launcher
