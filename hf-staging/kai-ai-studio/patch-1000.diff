+        return run
+
+    def skip(self, run_id: str, index: int) -> dict[str, Any]:
+        run = self.get_run(run_id)
+        item = run["items"][index]
+        item["status"] = "skipped"
+        item["skipped_at"] = _now()
+        self._advance_cursor(run, index)
+        run["updated_at"] = _now()
+        _atomic_json(self._run_path(run_id), run)
+        return run
