+@spaces.GPU(duration=120)
+def kai_edit_pair(
+    image_path: str,
+    prompt: str,
+    seed: int = 0,
+    steps: int = 10,
+    randomize_seed: bool = True,
+):
+    """Genera dos candidatos en una sola sesión de ZeroGPU."""
+    _cleanup()
+    clean_prompt = _validate_kai_input(image_path, prompt)
+    try:
+        _load_adapter("Sin LoRA (base)")
+        pair = generate_pair(
+            _kai_edit_one,
+            source=image_path,
+            prompt=clean_prompt,
+            seed=int(seed),
+            randomize=bool(randomize_seed),
+            steps=int(steps),
+        )
+        return pair["a"], pair["b"], pair["seed_a"], pair["seed_b"]
+    finally:
+        pipe.release()
+        _cleanup()
+
