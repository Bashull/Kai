+def studio_create_profile(display_name: str):
+    profile = studio_store.create_profile(display_name or "Default")
+    return profile["id"], profile
+
+
+def studio_start_run(profile_id: str, prompt: str, sources, steps: int = 10):
+    paths = [p for p in _as_path_list(sources) if _is_image_path(p)]
+    if not paths:
+        raise gr.Error("No hay imágenes para iniciar el lote.")
+    run = studio_store.start_run(
+        profile_id,
+        (prompt or "").strip(),
+        {"steps": int(steps)},
+        sorted(paths, key=lambda p: Path(p).name.lower()),
+    )
+    return run["id"], run
+
+
+def _component_path(value) -> str:
+    if isinstance(value, str):
+        return value
+    if isinstance(value, dict):
+        return value.get("path") or value.get("name") or ""
+    return getattr(value, "path", None) or getattr(value, "name", None) or ""
+
+
+def studio_record_review(run_id: str, index: int, candidate_a, candidate_b, seed_a: int, seed_b: int):
+    path_a = _component_path(candidate_a)
+    path_b = _component_path(candidate_b)
+    if not path_a or not path_b:
+        raise gr.Error("No encuentro los dos candidatos A/B para guardarlos.")
