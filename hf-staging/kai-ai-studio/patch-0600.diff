+++ b/kai_studio/copilot.py
@@ -0,0 +1,66 @@
+from __future__ import annotations
+
+from typing import Any
+
+DEFAULT_MODEL = "Qwen/Qwen3-Next-80B-A3B-Instruct"
+DEFAULT_SYSTEM_PROMPT = (
+    "You are Kai, an expert image-editing copilot. Improve prompts while preserving the user's intent, "
+    "identity constraints, physical consistency, and requested visual style. Be concise and practical."
+)
+
+
+def build_messages(system_prompt: str, history, message: str) -> list[dict[str, str]]:
+    messages = [{"role": "system", "content": (system_prompt or DEFAULT_SYSTEM_PROMPT).strip()}]
+    for item in history or []:
+        if not isinstance(item, dict):
+            continue
+        role = item.get("role")
+        content = item.get("content")
+        if role in {"user", "assistant"} and isinstance(content, str) and content.strip():
+            messages.append({"role": role, "content": content.strip()})
+    clean = (message or "").strip()
+    if clean:
+        messages.append({"role": "user", "content": clean})
+    return messages
+
+
+def _token_value(oauth_token: Any) -> str:
+    if isinstance(oauth_token, str):
+        return oauth_token.strip()
+    return (getattr(oauth_token, "token", None) or "").strip()
+
+
+def _extract_content(response: Any) -> str:
+    if isinstance(response, dict):
+        return str(response["choices"][0]["message"]["content"]).strip()
+    choices = getattr(response, "choices", None)
+    if choices:
+        message = getattr(choices[0], "message", None)
+        content = getattr(message, "content", None)
+        if content is not None:
+            return str(content).strip()
+    raise ValueError("Inference Provider returned no text content")
+
+
+def copilot_reply(
+    message: str,
+    history=None,
+    *,
+    system_prompt: str = DEFAULT_SYSTEM_PROMPT,
+    oauth_token=None,
+    client_factory=None,
+    max_tokens: int = 700,
+) -> str:
+    token = _token_value(oauth_token)
+    if not token:
+        raise ValueError("Sign in with Hugging Face before using Kai Copilot")
+    if client_factory is None:
+        from huggingface_hub import InferenceClient
+        client_factory = InferenceClient
+    client = client_factory(token=token)
+    response = client.chat_completion(
+        model=DEFAULT_MODEL,
+        messages=build_messages(system_prompt, history, message),
+        max_tokens=int(max_tokens),
+    )
+    return _extract_content(response)
