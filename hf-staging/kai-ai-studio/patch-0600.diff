+from __future__ import annotations
+
+import random
+from collections.abc import Callable
+from typing import Any
+
+MAX_SEED = 2**31 - 1
+
+
+def variant_seeds(base_seed: int, randomize: bool, rng=None) -> tuple[int, int]:
+    if not randomize:
+        first = int(base_seed) % (MAX_SEED + 1)
+        second = (first + 1) % (MAX_SEED + 1)
+        return first, second
+
+    rng = rng or random.SystemRandom()
+    first = rng.randint(0, MAX_SEED)
+    second = rng.randint(0, MAX_SEED)
+    while second == first:
+        second = rng.randint(0, MAX_SEED)
+    return first, second
+
+
+def generate_pair(
+    generate_one: Callable[..., Any],
+    *,
+    source: Any,
+    prompt: str,
+    seed: int,
+    randomize: bool,
+    rng=None,
+    **kwargs,
+) -> dict[str, Any]:
+    seed_a, seed_b = variant_seeds(seed, randomize, rng=rng)
+    result_a = generate_one(source=source, prompt=prompt, seed=seed_a, **kwargs)
+    result_b = generate_one(source=source, prompt=prompt, seed=seed_b, **kwargs)
+    return {
+        "a": result_a,
+        "b": result_b,
+        "seed_a": seed_a,
+        "seed_b": seed_b,
+    }
