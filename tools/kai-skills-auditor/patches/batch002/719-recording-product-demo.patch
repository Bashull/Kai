 const SKIP_GRID = process.argv.includes('--skip-grid');
 const DRY_RUN = process.argv.includes('--dry-run');
 
+function invalid(message) {
+  console.error(`[asm] ERROR: ${message}`);
+  process.exit(1);
+}
+function readJson(file, label) {
+  try { return JSON.parse(fs.readFileSync(file, 'utf8')); }
+  catch (e) { invalid(`cannot read ${label}: ${e.message}`); }
+}
+function finiteTime(value, label, positive = false) {
+  if (typeof value !== 'number' || !Number.isFinite(value) ||
+      (positive ? value <= 0 : value < 0)) {
+    invalid(`${label} must be a finite ${positive ? 'positive' : 'non-negative'} number`);
+  }
+}
+function dimensions(value, label, even = false) {
+  if (!Array.isArray(value) || value.length !== 2 ||
+      value.some((n) => !Number.isSafeInteger(n) || n <= 0 || (even && n % 2 !== 0))) {
+    invalid(`${label} must contain exactly two positive ${even ? 'even ' : ''}integer dimensions`);
+  }
+}
+function validateInputs(meta, timeline) {
+  if (!meta || typeof meta !== 'object' || Array.isArray(meta)) invalid('take metadata must be an object');
+  if (typeof meta.webm !== 'string' || !meta.webm.trim() || meta.webm.includes('\0')) {
+    invalid('take metadata webm must be a non-empty path string');
+  }
+  finiteTime(meta.t0Seconds, 't0Seconds');
+  finiteTime(meta.narrationEnd, 'narrationEnd', true);
+  if (meta.viewport !== undefined) dimensions(meta.viewport, 'viewport');
+  if (meta.output !== undefined) dimensions(meta.output, 'output', true); // yuv420p
+  if (!Array.isArray(timeline) || !timeline.length) invalid('timeline must be a non-empty array');
+  const epsilon = 1e-6;
+  let previousEnd = 0;
+  for (let i = 0; i < timeline.length; i++) {
+    const scene = timeline[i];
+    if (!scene || typeof scene !== 'object' || Array.isArray(scene)) invalid(`timeline[${i}] must be an object`);
+    finiteTime(scene.start, `timeline[${i}].start`);
+    finiteTime(scene.end, `timeline[${i}].end`, true);
+    if (scene.end <= scene.start) invalid(`timeline[${i}] must end after it starts`);
+    if (Math.abs(scene.start - previousEnd) > epsilon) {
+      invalid(`timeline[${i}].start must equal ${i ? 'the previous scene end' : 'zero'}`);
+    }
+    previousEnd = scene.end;
+  }
+  if (Math.abs(previousEnd - meta.narrationEnd) > epsilon) {
+    invalid('timeline end must match narrationEnd');
+  }
+  if (meta.boundaries !== undefined) {
+    const expected = [...timeline.map((scene) => scene.start), previousEnd];
+    if (!Array.isArray(meta.boundaries) || meta.boundaries.length !== expected.length) {
+      invalid('take boundaries must match the timeline boundary count');
+    }
+    meta.boundaries.forEach((value, i) => {
+      finiteTime(value, `boundaries[${i}]`);
+      if (Math.abs(value - expected[i]) > epsilon) invalid(`boundaries[${i}] must match the timeline`);
+    });
+  }
+}
+
+// Validate the same contract before planning OR invoking any media process.
+const meta0 = readJson(path.join(BUILD, 'out/take-meta.json'), 'take metadata');
+const timeline0 = readJson(path.join(BUILD, 'out/voice/timeline.json'), 'timeline');
+validateInputs(meta0, timeline0);
+
