{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "kai-meshy-mcp": {
      "type": "stdio",
      "command": "python",
      "args": ["${PLUGIN_ROOT}/launch.py", "stdio"],
      "env": {"KAI_MESHY_ALLOW_WRITES": "0", "KAI_MESHY_ALLOW_SPEND": "0", "KAI_MESHY_ALLOW_APPROVALS": "0"}
    }
  }
}
